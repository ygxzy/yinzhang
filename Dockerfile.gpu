# 印章识别服务 - GPU 版本（CUDA 12.6）
# 构建：docker build -f Dockerfile.gpu -t seal-service:gpu .
# 运行：docker run --gpus all -p 8000:8000 seal-service:gpu

FROM nvidia/cuda:12.6.2-cudnn-runtime-ubuntu22.04

# 系统依赖 + Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    python3 \
    python3-pip \
    python3-venv \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 先装依赖（利用 Docker 缓存）
COPY requirements-base.txt requirements-gpu.txt ./
# GPU 版 paddlepaddle-gpu 必须从百度源安装，不能用清华源覆盖
RUN pip install --no-cache-dir -r requirements-gpu.txt

# 拷贝代码
COPY . .

# 模型缓存目录（容器内）
ENV PADDLE_PDX_CACHE_DIR=/root/.paddlex

EXPOSE 8000

# 启动命令（GPU 版可适当增加 worker）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
